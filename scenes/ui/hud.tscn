[node name="BriefingText" type="Label" parent="Overlays/BriefingOverlay/CenterContainer/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_font_sizes/font_size = 12
text = "MISSION BRIEFING:
• Retrieve 10 Energy Cores to establish an extraction uplink.
• Automated defense drones patrol the sector. If detected, hostiles will pursue.
• Touching active drones depletes your shields.

DISRUPTION PULSE [SPACE]:
• Emits an expanding circular EMP shockwave.
• Temporarily STUNS all hostiles within the blast radius.
• Consumes 25 energy. Collect cores to replenish energy.

CONTROLS:
• WASD / Arrow Keys: Move
• SPACE: Fire Disruption Pulse
• R: Restart Mission"

